# ========================================================================
# iPhone UP — variables de entorno
# Copia este archivo a `.env` y completa con credenciales reales.
# NUNCA subir `.env` al repo.
# ========================================================================

# Puerto del servidor Express
PORT=8080

# URL pública del sitio (sin slash final). Usada para back_urls y notification_url de MP.
# En local: http://localhost:8080
# En prod : https://iphoneup.cl
PUBLIC_URL=http://localhost:8080

# ========================================================================
# MERCADO PAGO (Chile)
# Obtener en: https://www.mercadopago.cl/developers/panel/app
# El cliente debe crear una aplicación con tipo "CheckoutPro".
# ========================================================================
MP_ACCESS_TOKEN=APP_USR-XXXXXXXX-XXXXXX-XXXXXXXXXXXXXXXXXXXXXXXX-XXXXXXXXX
MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Webhook secret (opcional, MP lo entrega al configurar el webhook en el panel)
MP_WEBHOOK_SECRET=

# ========================================================================
# CHILEXPRESS API
# Obtener en: https://developers.chilexpress.cl/
# El cliente debe registrarse, suscribirse a los productos:
#   - Cotizador (Rating)
#   - Geo Referencia (Regions / Coverage Areas)
# y obtener la "subscription-key" de cada uno (suele ser la misma).
# ========================================================================
CHILEXPRESS_API_KEY_RATING=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHILEXPRESS_API_KEY_GEO=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Datos de origen del envío (tienda iPhone UP — Providencia)
# Código de comuna Chilexpress para "Providencia". Verificar con endpoint
# /geo-reference/coverage-areas?regionCode=RM al levantar la API.
CHILEXPRESS_ORIGIN_COUNTY_CODE=PROV
CHILEXPRESS_ORIGIN_COUNTY_NAME=Providencia
CHILEXPRESS_ORIGIN_REGION_CODE=RM
