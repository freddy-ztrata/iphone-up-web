# ========================================================================
# iPhone UP — variables de entorno
# Copia este archivo a `.env` y completa con credenciales reales.
# NUNCA subir `.env` al repo.
# ========================================================================

# Puerto del servidor Express
PORT=8080

# URL pública del sitio (sin slash final). Usada para back_urls y notification_url de MP.
# En local: http://localhost:8080
# En prod : https://iphoneup.cl
PUBLIC_URL=http://localhost:8080

# Directorio raíz donde viven DB, uploads y backups. En Docker = /data (volumen).
# En local puedes dejar el default ./data
DATA_DIR=./data

# ========================================================================
# ADMIN PANEL
# ========================================================================
# Secret para firmar cookies de sesión. Genera uno con: openssl rand -hex 32
SESSION_SECRET=cambia-esto-por-un-string-aleatorio-largo

# Credenciales del primer usuario admin (se crea al boot si no existe ninguno).
# Después de bootear por primera vez, cambia la contraseña desde el admin y
# borra estas variables o déjalas — solo se usan si la tabla `users` está vacía.
ADMIN_BOOTSTRAP_EMAIL=admin@iphoneup.cl
ADMIN_BOOTSTRAP_PASSWORD=cambia-esto

# Feature flag: cuando es "true", el frontend público lee el catálogo desde la DB.
# Cuando es "false", sirve el data.js físico del repo (fallback en caso de problemas).
USE_DB_CATALOG=true

# ========================================================================
# MERCADO PAGO (Chile)
# Obtener en: https://www.mercadopago.cl/developers/panel/app
# ========================================================================
MP_ACCESS_TOKEN=APP_USR-XXXXXXXX-XXXXXX-XXXXXXXXXXXXXXXXXXXXXXXX-XXXXXXXXX
MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Webhook secret (MP lo entrega al configurar el webhook en el panel).
# Si lo dejas vacío el backend NO valida la firma — agujero de seguridad.
MP_WEBHOOK_SECRET=

# ========================================================================
# CHILEXPRESS API
# Obtener en: https://developers.chilexpress.cl/
# ========================================================================
CHILEXPRESS_API_KEY_RATING=
CHILEXPRESS_API_KEY_GEO=
CHILEXPRESS_ORIGIN_COUNTY_CODE=PROV
CHILEXPRESS_ORIGIN_COUNTY_NAME=Providencia
CHILEXPRESS_ORIGIN_REGION_CODE=RM
