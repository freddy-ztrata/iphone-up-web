# ========================================================================
# iPhone UP — variables de entorno
# Copia este archivo a `.env` y completa con credenciales reales.
# NUNCA subir `.env` al repo.
# ========================================================================

# Puerto del servidor Express
PORT=8080

# URL pública del sitio (sin slash final). Usada para back_urls y notification_url de MP.
# En local: http://localhost:8080
# En prod : https://iphoneup.cl
PUBLIC_URL=http://localhost:8080

# Directorio raíz donde viven DB, uploads y backups. En Docker = /data (volumen).
# En local puedes dejar el default ./data
DATA_DIR=./data

# ========================================================================
# ADMIN PANEL
# ========================================================================
# Secret para firmar cookies de sesión. Genera uno con: openssl rand -hex 32
SESSION_SECRET=cambia-esto-por-un-string-aleatorio-largo

# Credenciales del primer usuario admin (se crea al boot si no existe ninguno).
# Después de bootear por primera vez, cambia la contraseña desde el admin y
# borra estas variables o déjalas — solo se usan si la tabla `users` está vacía.
ADMIN_BOOTSTRAP_EMAIL=admin@iphoneup.cl
ADMIN_BOOTSTRAP_PASSWORD=cambia-esto

# Feature flag: cuando es "true", el frontend público lee el catálogo desde la DB.
# Cuando es "false", sirve el data.js físico del repo (fallback en caso de problemas).
USE_DB_CATALOG=true

# ========================================================================
# MERCADO PAGO (Chile)
# Obtener en: https://www.mercadopago.cl/developers/panel/app
# ========================================================================
MP_ACCESS_TOKEN=APP_USR-XXXXXXXX-XXXXXX-XXXXXXXXXXXXXXXXXXXXXXXX-XXXXXXXXX
MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Webhook secret (MP lo entrega al configurar el webhook en el panel).
# Si lo dejas vacío el backend NO valida la firma — agujero de seguridad.
MP_WEBHOOK_SECRET=

# ========================================================================
# CHILEXPRESS API
# Obtener en: https://developers.chilexpress.cl/
# ========================================================================
CHILEXPRESS_API_KEY_RATING=
CHILEXPRESS_API_KEY_GEO=
CHILEXPRESS_ORIGIN_COUNTY_CODE=PROV
CHILEXPRESS_ORIGIN_COUNTY_NAME=Providencia
CHILEXPRESS_ORIGIN_REGION_CODE=RM

# ========================================================================
# EMAILS TRANSACCIONALES (Resend) + CARRITOS ABANDONADOS
# API key en: https://resend.com/api-keys
# ========================================================================
# SIN RESEND_API_KEY todo queda en modo DRY-RUN: los emails se renderizan, se
# registran en el historial del admin (Ajustes → Emails) y NO se envían. Es el
# default en local y el único modo seguro para probar.
RESEND_API_KEY=

# Secret del webhook de Resend (Settings → Webhooks → Signing Secret).
# Empieza con "whsec_". Si lo dejás vacío el backend NO valida la firma y
# cualquiera podría reportar rebotes falsos para meter clientes en la lista de
# exclusión. En producción es obligatorio.
RESEND_WEBHOOK_SECRET=

# Secret para firmar los links de baja (unsubscribe) de los emails.
# Si lo dejás vacío se usa SESSION_SECRET; consecuencia: rotar SESSION_SECRET
# invalida los links de baja de los correos ya enviados.
EMAIL_UNSUBSCRIBE_SECRET=

# --- Defaults de la config editable en Ajustes → Emails ---
# Solo aplican mientras nadie los haya tocado desde el panel: el valor guardado
# en la tabla `settings` siempre gana. Sirven para dejar el deploy configurado
# sin entrar al admin.
#
# Remitente. El dominio tiene que estar VERIFICADO en Resend. El default de
# fábrica es "iPhone UP <onboarding@resend.dev>" (sandbox de Resend: solo
# entrega al dueño de la cuenta, imposible spamear a un tercero sin querer).
EMAIL_FROM="iPhone UP <hola@iphoneup.cl>"
# Vacío = no se manda la cabecera Reply-To (las respuestas van al remitente).
EMAIL_REPLY_TO=
# Vacío = los avisos internos de venta nueva quedan DESACTIVADOS.
EMAIL_INTERNAL_TO=
# "false" apaga TODOS los emails (incluidos los transaccionales). También hay un
# switch en Ajustes → Emails, que es el que usa el cliente.
EMAILS_ENABLED=true

# --- Scheduler de emails diferidos (recordatorios de carro + follow-up) ---
# "false" apaga el ciclo en background.
EMAIL_SCHEDULER_ENABLED=true
# Cada cuántos minutos corre el ciclo.
EMAIL_SCHEDULER_INTERVAL_MINUTES=10
# Tope de emails por tarea y por ciclo: evita que un backlog (scheduler apagado
# unos días) dispare cientos de correos de golpe.
EMAIL_SCHEDULER_BATCH=25
# Timeout de cada request a la API de Resend, en ms.
RESEND_TIMEOUT_MS=10000
